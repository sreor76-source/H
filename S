-- Logic 1: Select Vehicle
SelectBtn.MouseButton1Click:Connect(function()
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.SeatPart then
        local seat = humanoid.SeatPart
        selectedVehicle = seat:FindFirstAncestorOfClass("Model")
        
        if selectedVehicle then
            StatusLabel.Text = "تم حفظ المركبة: " .. selectedVehicle.Name .. "\nاضغط زر 2 ثم انقر بالماوس ع الأرض"
        end
    else
        StatusLabel.Text = "خطأ: اركب المركبة المراد نسخها أولاً!"
    end
end)

-- Logic 2: Activate Placement Mode
PlaceModeBtn.MouseButton1Click:Connect(function()
    if not selectedVehicle then
        StatusLabel.Text = "خطأ: حدد المركبة أولاً (خطوة 1)!"
        return
    end
    
    isPlacing = true
    StatusLabel.Text = "وضع الترسيبن مفعل!\nانقر بالماوس في أي مكان بالأرض لترسيبنها."
end)

-- Logic 3: Mouse Click Handler to Spawn/Move Vehicle at Mouse Hit
Mouse.Button1Down:Connect(function()
    if not isPlacing or not selectedVehicle then return end
    
    local targetPos = Mouse.Hit
    if targetPos then
        local success, err = pcall(function()
            local clone = selectedVehicle:Clone()
            clone.Parent = Workspace
            
            -- ضبط الموقع فوق نقطة الماوس بمسافة بسيطة لكي لا تنغرس بالأرض، وتكون معدولة
            local pos = targetPos.Position + Vector3.new(0, 3, 0)
            local uprightCFrame = CFrame.new(pos)
            
            local primary = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart")
            if primary then
                clone:SetPrimaryPartCFrame(uprightCFrame)
            else
                for _, part in ipairs(clone:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CFrame = uprightCFrame
                        break
                    end
                end
            end
            
            -- إيقاف الفيزياء والسرعة لثبات تام
            for _, part in ipairs(clone:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
            end
        end)
        
        if success then
            StatusLabel.Text = "تم ترسيبن المركبة في المكان المحدّد بالماوس بنجاح!"
        else
            StatusLabel.Text = "فشل الترسيبن (حماية الماب)"
        end
        
        isPlacing = false -- إيقاف وضع الترسيبن بعد النقرة
    end
end)

-- Reset Button Logic
ResetBtn.MouseButton1Click:Connect(function()
    selectedVehicle = nil
    isPlacing = false
    StatusLabel.Text = "تم إلغاء التحديد."
end)

-- Toggle Visibility with 'L'
UserInputService.InputBegan:Connect(function(input, isTyping)
    if isTyping then return end
    if input.KeyCode == Enum.KeyCode.L then
        MainFrame.Visible = not MainFrame.Visible
    end
end)
